prefix_rule(
    pattern=[
        "aws",
        "accessanalyzer",
        [
            "apply-archive-rule",
            "cancel-policy-generation",
            "check-access-not-granted",
            "check-no-new-access",
            "check-no-public-access",
            "create-access-preview",
            "create-analyzer",
            "create-archive-rule",
            "create-service-linked-analyzer",
            "delete-analyzer",
            "delete-archive-rule",
            "delete-service-linked-analyzer",
            "generate-finding-recommendation",
            "get-access-preview",
            "get-analyzed-resource",
            "get-analyzer",
            "get-archive-rule",
            "get-finding",
            "get-finding-recommendation",
            "get-finding-v2",
            "get-findings-statistics",
            "get-generated-policy",
            "list-access-preview-findings",
            "list-access-previews",
            "list-analyzed-resources",
            "list-analyzers",
            "list-archive-rules",
            "list-findings",
            "list-findings-v2",
            "list-policy-generations",
            "list-tags-for-resource",
            "start-policy-generation",
            "start-resource-scan",
            "tag-resource",
            "untag-resource",
            "update-analyzer",
            "update-archive-rule",
            "update-findings",
            "validate-policy",
        ],
        "help",
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws accessanalyzer apply-archive-rule help",
        "aws accessanalyzer cancel-policy-generation help",
        "aws accessanalyzer check-access-not-granted help",
        "aws accessanalyzer check-no-new-access help",
        "aws accessanalyzer check-no-public-access help",
        "aws accessanalyzer create-access-preview help",
        "aws accessanalyzer create-analyzer help",
        "aws accessanalyzer create-archive-rule help",
        "aws accessanalyzer create-service-linked-analyzer help",
        "aws accessanalyzer delete-analyzer help",
        "aws accessanalyzer delete-archive-rule help",
        "aws accessanalyzer delete-service-linked-analyzer help",
        "aws accessanalyzer generate-finding-recommendation help",
        "aws accessanalyzer get-access-preview help",
        "aws accessanalyzer get-analyzed-resource help",
        "aws accessanalyzer get-analyzer help",
        "aws accessanalyzer get-archive-rule help",
        "aws accessanalyzer get-finding help",
        "aws accessanalyzer get-finding-recommendation help",
        "aws accessanalyzer get-finding-v2 help",
        "aws accessanalyzer get-findings-statistics help",
        "aws accessanalyzer get-generated-policy help",
        "aws accessanalyzer list-access-preview-findings help",
        "aws accessanalyzer list-access-previews help",
        "aws accessanalyzer list-analyzed-resources help",
        "aws accessanalyzer list-analyzers help",
        "aws accessanalyzer list-archive-rules help",
        "aws accessanalyzer list-findings help",
        "aws accessanalyzer list-findings-v2 help",
        "aws accessanalyzer list-policy-generations help",
        "aws accessanalyzer list-tags-for-resource help",
        "aws accessanalyzer start-policy-generation help",
        "aws accessanalyzer start-resource-scan help",
        "aws accessanalyzer tag-resource help",
        "aws accessanalyzer untag-resource help",
        "aws accessanalyzer update-analyzer help",
        "aws accessanalyzer update-archive-rule help",
        "aws accessanalyzer update-findings help",
        "aws accessanalyzer validate-policy help",
    ],
    not_match=[
        "aws accessanalyzer __not-a-command__ help",
        "aws account apply-archive-rule help",
    ],
)

prefix_rule(
    pattern=[
        "aws",
        "account",
        [
            "accept-primary-email-update",
            "delete-alternate-contact",
            "disable-region",
            "enable-region",
            "get-account-information",
            "get-alternate-contact",
            "get-contact-information",
            "get-gov-cloud-account-information",
            "get-primary-email",
            "get-primary-email-update-status",
            "get-region-opt-status",
            "list-regions",
            "put-account-name",
            "put-alternate-contact",
            "put-contact-information",
            "start-primary-email-update",
        ],
        "help",
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws account accept-primary-email-update help",
        "aws account delete-alternate-contact help",
        "aws account disable-region help",
        "aws account enable-region help",
        "aws account get-account-information help",
        "aws account get-alternate-contact help",
        "aws account get-contact-information help",
        "aws account get-gov-cloud-account-information help",
        "aws account get-primary-email help",
        "aws account get-primary-email-update-status help",
        "aws account get-region-opt-status help",
        "aws account list-regions help",
        "aws account put-account-name help",
        "aws account put-alternate-contact help",
        "aws account put-contact-information help",
        "aws account start-primary-email-update help",
    ],
    not_match=[
        "aws account __not-a-command__ help",
        "aws accessanalyzer accept-primary-email-update help",
    ],
)

