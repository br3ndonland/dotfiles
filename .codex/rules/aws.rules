prefix_rule(
    pattern=[
        "aws",
        "ecr",
        [
            "batch-check-layer-availability",
            "batch-get-repository-scanning-configuration",
            "describe-image-replication-status",
            "describe-image-scan-findings",
            "describe-image-signing-status",
            "describe-images",
            "describe-pull-through-cache-rules",
            "describe-registry",
            "describe-repositories",
            "describe-repository-creation-templates",
            "get-account-setting",
            "get-authorization-token",
            "get-lifecycle-policy",
            "get-lifecycle-policy-preview",
            "get-registry-policy",
            "get-registry-scanning-configuration",
            "get-repository-policy",
            "get-signing-configuration",
            "list-images",
            "list-pull-time-update-exclusions",
            "list-tags-for-resource",
            "validate-pull-through-cache-rule",
        ],
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws ecr batch-check-layer-availability",
        "aws ecr batch-get-repository-scanning-configuration",
        "aws ecr describe-image-replication-status",
        "aws ecr describe-image-scan-findings",
        "aws ecr describe-image-signing-status",
        "aws ecr describe-images",
        "aws ecr describe-pull-through-cache-rules",
        "aws ecr describe-registry",
        "aws ecr describe-repositories",
        "aws ecr describe-repository-creation-templates",
        "aws ecr get-account-setting",
        "aws ecr get-authorization-token",
        "aws ecr get-lifecycle-policy",
        "aws ecr get-lifecycle-policy-preview",
        "aws ecr get-registry-policy",
        "aws ecr get-registry-scanning-configuration",
        "aws ecr get-repository-policy",
        "aws ecr get-signing-configuration",
        "aws ecr list-images",
        "aws ecr list-pull-time-update-exclusions",
        "aws ecr list-tags-for-resource",
        "aws ecr validate-pull-through-cache-rule",
    ],
    not_match=[
        "aws ecr batch-delete-image",
        "aws accessanalyzer batch-check-layer-availability",
    ],
)

prefix_rule(
    pattern=[
        "aws",
        "ecr-public",
        [
            "batch-check-layer-availability",
            "describe-image-tags",
            "describe-images",
            "describe-registries",
            "describe-repositories",
            "get-authorization-token",
            "get-registry-catalog-data",
            "get-repository-catalog-data",
            "get-repository-policy",
            "list-tags-for-resource",
        ],
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws ecr-public batch-check-layer-availability",
        "aws ecr-public describe-image-tags",
        "aws ecr-public describe-images",
        "aws ecr-public describe-registries",
        "aws ecr-public describe-repositories",
        "aws ecr-public get-authorization-token",
        "aws ecr-public get-registry-catalog-data",
        "aws ecr-public get-repository-catalog-data",
        "aws ecr-public get-repository-policy",
        "aws ecr-public list-tags-for-resource",
    ],
    not_match=[
        "aws ecr-public batch-delete-image",
        "aws accessanalyzer batch-check-layer-availability",
    ],
)

