prefix_rule(
    pattern=[
        "aws",
        "dynamodbstreams",
        [
            "describe-stream",
            "get-records",
            "get-shard-iterator",
            "list-streams",
        ],
        "help",
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws dynamodbstreams describe-stream help",
        "aws dynamodbstreams get-records help",
        "aws dynamodbstreams get-shard-iterator help",
        "aws dynamodbstreams list-streams help",
    ],
    not_match=[
        "aws dynamodbstreams __not-a-command__ help",
        "aws accessanalyzer describe-stream help",
    ],
)

prefix_rule(
    pattern=[
        "aws",
        "ebs",
        [
            "complete-snapshot",
            "get-snapshot-block",
            "list-changed-blocks",
            "list-snapshot-blocks",
            "put-snapshot-block",
            "start-snapshot",
        ],
        "help",
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws ebs complete-snapshot help",
        "aws ebs get-snapshot-block help",
        "aws ebs list-changed-blocks help",
        "aws ebs list-snapshot-blocks help",
        "aws ebs put-snapshot-block help",
        "aws ebs start-snapshot help",
    ],
    not_match=[
        "aws ebs __not-a-command__ help",
        "aws accessanalyzer complete-snapshot help",
    ],
)

