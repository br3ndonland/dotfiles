            "list-acme-domain-validations",
            "list-acme-endpoints",
            "list-acme-external-account-bindings",
            "list-certificates",
            "list-tags-for-certificate",
            "list-tags-for-resource",
            "search-certificates",
        ],
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws acm describe-acme-account",
        "aws acm describe-acme-domain-validation",
        "aws acm describe-acme-endpoint",
        "aws acm describe-acme-external-account-binding",
        "aws acm describe-certificate",
        "aws acm export-certificate",
        "aws acm get-account-configuration",
        "aws acm get-acme-external-account-binding-credentials",
        "aws acm get-certificate",
        "aws acm list-acme-accounts",
