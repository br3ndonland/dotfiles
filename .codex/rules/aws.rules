# Codex AWS CLI rules
#
# https://developers.openai.com/codex/rules
# https://github.com/bazelbuild/starlark/blob/master/spec.md
# The Codex VSCode extension can provide syntax highlighting (language ID codex-rules).
# Ruff can perform simple formatting. See scripts/ruff-rules.sh for commands.

# The following rules relate to AWS CLI commands.
# List, read, write, and other verbs are defined based on the Service Authorization Reference.
# https://docs.aws.amazon.com/service-authorization/latest/reference/reference.html
# Generated for AWS CLI v2.36.15 from the official service reference.
# https://servicereference.us-east-1.amazonaws.com/

# These rules allow AWS CLI read and list commands.

prefix_rule(
    pattern=[
        "aws",
        "accessanalyzer",
        [
            "check-access-not-granted",
            "check-no-new-access",
            "check-no-public-access",
            "get-access-preview",
            "get-analyzed-resource",
            "get-analyzer",
            "get-archive-rule",
            "get-finding",
            "get-finding-recommendation",
            "get-finding-v2",
            "get-findings-statistics",
            "get-generated-policy",
            "list-access-preview-findings",
            "list-access-previews",
            "list-analyzed-resources",
            "list-analyzers",
            "list-archive-rules",
            "list-findings",
            "list-findings-v2",
            "list-policy-generations",
            "list-tags-for-resource",
            "validate-policy",
        ],
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws accessanalyzer check-access-not-granted",
        "aws accessanalyzer check-no-new-access",
        "aws accessanalyzer check-no-public-access",
        "aws accessanalyzer get-access-preview",
        "aws accessanalyzer get-analyzed-resource",
        "aws accessanalyzer get-analyzer",
        "aws accessanalyzer get-archive-rule",
        "aws accessanalyzer get-finding",
        "aws accessanalyzer get-finding-recommendation",
        "aws accessanalyzer get-finding-v2",
        "aws accessanalyzer get-findings-statistics",
        "aws accessanalyzer get-generated-policy",
        "aws accessanalyzer list-access-preview-findings",
        "aws accessanalyzer list-access-previews",
        "aws accessanalyzer list-analyzed-resources",
        "aws accessanalyzer list-analyzers",
        "aws accessanalyzer list-archive-rules",
        "aws accessanalyzer list-findings",
        "aws accessanalyzer list-findings-v2",
        "aws accessanalyzer list-policy-generations",
        "aws accessanalyzer list-tags-for-resource",
        "aws accessanalyzer validate-policy",
    ],
    not_match=[
        "aws accessanalyzer apply-archive-rule",
        "aws account check-access-not-granted",
    ],
)

prefix_rule(
    pattern=[
        "aws",
        "account",
        [
            "get-account-information",
            "get-alternate-contact",
            "get-contact-information",
            "get-gov-cloud-account-information",
            "get-primary-email",
            "get-primary-email-update-status",
            "get-region-opt-status",
            "list-regions",
        ],
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws account get-account-information",
        "aws account get-alternate-contact",
        "aws account get-contact-information",
        "aws account get-gov-cloud-account-information",
        "aws account get-primary-email",
        "aws account get-primary-email-update-status",
        "aws account get-region-opt-status",
        "aws account list-regions",
    ],
    not_match=[
        "aws account accept-primary-email-update",
        "aws accessanalyzer get-account-information",
    ],
)

prefix_rule(
    pattern=[
        "aws",
        "acm",
        [
            "describe-acme-account",
            "describe-acme-domain-validation",
