prefix_rule(
    pattern=[
        "aws",
        "iot-data",
        [
            "delete-connection",
            "delete-thing-shadow",
            "get-connection",
            "get-retained-message",
            "get-thing-shadow",
            "list-named-shadows-for-thing",
            "list-retained-messages",
            "list-subscriptions",
            "publish",
            "send-direct-message",
            "update-thing-shadow",
        ],
        "help",
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws iot-data delete-connection help",
        "aws iot-data delete-thing-shadow help",
        "aws iot-data get-connection help",
        "aws iot-data get-retained-message help",
        "aws iot-data get-thing-shadow help",
        "aws iot-data list-named-shadows-for-thing help",
        "aws iot-data list-retained-messages help",
        "aws iot-data list-subscriptions help",
        "aws iot-data publish help",
        "aws iot-data send-direct-message help",
        "aws iot-data update-thing-shadow help",
    ],
    not_match=[
        "aws iot-data __not-a-command__ help",
        "aws accessanalyzer delete-connection help",
    ],
)

prefix_rule(
    pattern=[
        "aws",
        "iot-jobs-data",
        [
            "describe-job-execution",
            "get-pending-job-executions",
            "start-command-execution",
            "start-next-pending-job-execution",
            "update-job-execution",
        ],
        "help",
    ],
    decision="allow",
    justification="Allow AWS CLI read and list commands",
    match=[
        "aws iot-jobs-data describe-job-execution help",
        "aws iot-jobs-data get-pending-job-executions help",
        "aws iot-jobs-data start-command-execution help",
        "aws iot-jobs-data start-next-pending-job-execution help",
        "aws iot-jobs-data update-job-execution help",
    ],
    not_match=[
        "aws iot-jobs-data __not-a-command__ help",
        "aws accessanalyzer describe-job-execution help",
    ],
)

