# Codex GitHub CLI rules
#
# https://developers.openai.com/codex/rules
# https://github.com/bazelbuild/starlark/blob/master/spec.md
# The Codex VSCode extension can provide syntax highlighting (language ID codex-rules).
# Ruff can perform simple formatting. See scripts/ruff-rules.sh for commands.

# These rules allow designated GitHub CLI (`gh`) commands.
prefix_rule(
    pattern=[
        "gh",
        [
            "attestation",
            "cache",
            "extension",
            "gist",
            "help",
            "issue",
            "pr",
            "project",
            "search",
            "stack",
            "status",
            "variable",
        ],
    ],
    decision="allow",
    justification="Allow designated GitHub CLI (`gh`) commands",
    match=[
        "gh attestation download",
        "gh extension browse",
        "gh pr create",
        "gh variable list",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        "auth",
        [
            "refresh",
            "status",
        ],
    ],
    decision="allow",
    justification="Allow designated GitHub CLI (`gh`) commands",
    match=[
        "gh auth status",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        [
            "gpg-key",
            "label",
            "org",
            "secret",
        ],
        "list",
    ],
    decision="allow",
    justification="Allow designated GitHub CLI (`gh`) commands",
    match=[
        "gh org list",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        [
            "gpg-key",
            "ssh-key",
        ],
        [
            "add",
            "delete",
        ],
    ],
    decision="forbidden",
    justification="Forbid agents from adding or deleting keys with the GitHub CLI (`gh`)",
    match=[
        "gh gpg-key add",
        "gh gpg-key delete",
        "gh ssh-key add",
        "gh ssh-key delete",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        "codespace",
        [
            "list",
            "logs",
            "view",
        ],
    ],
    decision="allow",
    justification="Allow designated GitHub CLI (`gh`) commands",
    match=[
        "gh codespace list",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        "config",
        [
            "get",
            "list",
        ],
    ],
    decision="allow",
    justification="Allow designated GitHub CLI (`gh`) commands",
    match=[
        "gh config get git_protocol",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        "extension",
        "install",
    ],
    decision="prompt",
    justification="Prompt before installing GitHub CLI (`gh`) extensions",
    match=[
        "gh extension install",
    ],
    not_match=[
        "gh extension browse",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        [
            "gist",
            "issue",
            "pr",
        ],
        "delete",
    ],
    decision="forbidden",
    justification="Forbid agents from deleting resources with the GitHub CLI (`gh`)",
    match=[
        "gh gist delete",
        "gh issue delete",
        "gh pr delete",
    ],
    not_match=[
        "gh gist create",
        "gh issue create",
        "gh pr create",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        "release",
        [
            "download",
            "list",
            "verify-asset",
            "verify",
            "view",
        ],
    ],
    decision="allow",
    justification="Allow designated GitHub CLI (`gh`) commands",
    match=[
        "gh release list",
    ],
    not_match=[
        "gh release delete",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        "repo",
        [
            "clone",
            "fork",
            "list",
            "view",
        ],
    ],
    decision="allow",
    justification="Allow designated GitHub CLI (`gh`) commands",
    match=[
        "gh repo clone foo/bar",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        "ruleset",
        [
            "check",
            "list",
            "view",
        ],
    ],
    decision="allow",
    justification="Allow designated GitHub CLI (`gh`) commands",
    match=[
        "gh ruleset check",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        "run",
        [
            "cancel",
            "download",
            "list",
            "rerun",
            "view",
            "watch",
        ],
    ],
    decision="allow",
    justification="Allow designated GitHub CLI (`gh`) commands",
    match=[
        "gh run view",
    ],
    not_match=[
        "gh run delete",
    ],
)

prefix_rule(
    pattern=[
        "gh",
        "workflow",
        [
            "list",
            "run",
            "view",
        ],
    ],
    decision="allow",
    justification="Allow designated GitHub CLI (`gh`) commands",
    match=[
        "gh workflow list",
    ],
)

# This rule allows use of the `gh_pr_threads` script for PR review operations.
# The script offers more comprehensive support for PR reviews than `gh pr review`
# but grants less privileges than allowing all `gh api` commands in general.
prefix_rule(
    pattern=[
        "gh_pr_threads",
        [
            "list",
            "reply",
            "request-copilot",
            "resolve",
        ],
    ],
    decision="allow",
    justification="Allow limited pull request review thread operations",
    match=[
        "gh_pr_threads list owner/repo 123",
        "gh_pr_threads reply PRRT_id addressed",
        "gh_pr_threads resolve PRRT_id",
        "gh_pr_threads request-copilot owner/repo 123",
    ],
    not_match=[
        "gh api graphql -f query=query",
        "gh_pr_threads delete owner/repo 123",
    ],
)
