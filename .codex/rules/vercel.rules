    match=[
        "vercel telemetry disable",
        "vercel telemetry enable",
    ],
)

# These rules forbid permanent, high-impact resource deletion. A human must run
# these commands manually after confirming the target and recovery plan.

prefix_rule(
    pattern=[
        [
            "vercel",
            "vc",
        ],
        [
            "project",
            "projects",
        ],
        [
            "delete",
            "remove",
            "rm",
        ],
    ],
    decision="forbidden",
    justification="Delete Vercel projects manually after confirming the target, backups, and recovery plan",
    match=[
        "vercel project remove my-project",
        "vercel projects rm my-project",
        "vc projects delete my-project",
    ],
    not_match=[
        "vercel projects inspect my-project",
        "vercel projects update my-project",
    ],
)

prefix_rule(
    pattern=[
        [
            "vercel",
            "vc",
        ],
        "domains",
        [
            "delete",
            "remove",
            "rm",
        ],
    ],
    decision="forbidden",
    justification="Remove Vercel domain ownership manually after confirming DNS and transfer state",
    match=[
        "vercel domains remove example.com",
        "vc domains rm example.com",
    ],
    not_match=[
        "vercel domains inspect example.com",
        "vercel domains verify example.com",
    ],
)

prefix_rule(
    pattern=[
        [
            "vercel",
            "vc",
        ],
        "blob",
        [
            "delete-store",
            "empty-store",
        ],
    ],
    decision="forbidden",
    justification="Empty or delete Vercel Blob stores manually after confirming the store and backups",
    match=[
        "vercel blob delete-store store_123",
        "vercel blob empty-store --store-id store_123",
    ],
    not_match=[
        "vercel blob del media/photo.jpg",
        "vercel blob list",
    ],
)

prefix_rule(
    pattern=[
        [
            "vercel",
            "vc",
        ],
        "global-config",
        [
            "delete",
            "remove",
            "rm",
        ],
    ],
    decision="forbidden",
    justification="Delete Vercel Global Config stores manually after confirming backups and consumers",
    match=[
        "vercel global-config remove feature-config",
