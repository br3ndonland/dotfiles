# These selected write commands support local development and configuration
# downloads without creating a deployment or mutating production resources.

prefix_rule(
    pattern=[
        [
            "vercel",
            "vc",
        ],
        [
            "build",
            "dev",
            "pull",
        ],
    ],
    decision="allow",
    justification="Allow Vercel local development and project configuration pulls",
    match=[
        "vercel build",
        "vercel dev --listen 127.0.0.1:3000",
        "vercel pull --environment preview",
    ],
    not_match=[
        "vercel deploy",
    ],
)

prefix_rule(
    pattern=[
        [
            "vercel",
            "vc",
        ],
        "env",
        "pull",
    ],
    decision="allow",
    justification="Allow Vercel environment variable downloads",
    match=[
        "vercel env pull .env.local",
    ],
    not_match=[
        "vercel env remove API_KEY production",
    ],
)

prefix_rule(
    pattern=[
        [
            "vercel",
            "vc",
        ],
        "microfrontends",
        "pull",
    ],
    decision="allow",
    justification="Allow Vercel microfrontends configuration downloads",
    match=[
        "vercel microfrontends pull",
    ],
)

prefix_rule(
    pattern=[
        [
