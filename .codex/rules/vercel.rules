# These rules prompt before deployments, arbitrary authenticated requests,
# purchases, credential issuance, resource mutations, and destructive actions.

prefix_rule(
    pattern=[
        [
            "vercel",
            "vc",
        ],
        [
            "agent",
            "api",
            "bisect",
            "buy",
            "cache",
            "curl",
            "deploy",
            "httpstat",
            "init",
            "link",
            "login",
            "logout",
            "mcp",
            "oauth-apps",
            "open",
            "promote",
            "redeploy",
            "rollback",
            "switch",
            "upgrade",
        ],
    ],
    decision="prompt",
    justification="Prompt before Vercel deployments, setup, purchases, arbitrary requests, or account changes",
    match=[
        "vercel api /v10/projects -X POST -F name=my-project",
        "vercel buy domain example.com",
        "vercel curl /api/users -- --request POST",
        "vercel deploy --prod",
        "vercel rollback deployment_123",
    ],
    not_match=[
        "vercel inspect deployment_123",
        "vercel list",
    ],
)

