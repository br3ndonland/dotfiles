# Codex Vercel CLI rules
#
# https://learn.chatgpt.com/docs/agent-configuration/rules
# https://vercel.com/docs/cli
# https://github.com/bazelbuild/starlark/blob/master/spec.md
# The Codex VSCode extension can provide syntax highlighting (language ID codex-rules).
# Ruff can perform simple formatting. See scripts/ruff-rules.sh for commands.
#
# Inventoried against Vercel CLI 58.9.4. Use explicit subcommands for command
# groups whose default action is read-only so that future write subcommands do
# not inherit an allow rule. Put global flags after the command path so prefix
# rules can match them. Unmatched forms, including a bare `vercel` deployment,
# retain Codex's default approval behavior.

# These rules allow Vercel CLI help, version, and top-level read-only commands.

prefix_rule(
    pattern=[
        [
            "vercel",
            "vc",
        ],
        [
            "--help",
            "--version",
            "-h",
            "-v",
            "help",
        ],
    ],
    decision="allow",
    justification="Allow Vercel CLI help and version commands",
    match=[
        "vercel --version",
        "vercel help deploy",
        "vc -v",
    ],
    not_match=[
        "vercel deploy",
    ],
)

prefix_rule(
    pattern=[
        [
            "vercel",
            "vc",
        ],
        [
            "activity",
            "alerts",
            "contract",
            "inspect",
            "list",
            "logs",
            "ls",
            "metrics",
            "skills",
            "usage",
            "whoami",
        ],
    ],
    decision="allow",
    justification="Allow Vercel CLI read-only commands",
    match=[
        "vercel activity --limit 20",
        "vercel inspect example.vercel.app",
        "vercel list --status READY",
        "vercel logs --level error --since 1h",
        "vercel metrics schema",
        "vc whoami",
    ],
    not_match=[
        "vercel deploy",
        "vercel remove example.vercel.app",
    ],
)

