{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
        "X-MCP-Toolsets": "{env:GITHUB_TOOLSETS}",
      },
    },
    "openai_developer_docs": {
      "type": "remote",
      "url": "https://developers.openai.com/mcp",
    },
    "opentofu": {
      "type": "remote",
      "url": "https://mcp.opentofu.org/mcp",
    },
    "spacelift": {
      "type": "remote",
      "url": "https://br3ndonland.app.spacelift.io/mcp",
    },
  },
  "permission": {
    // https://opencode.ai/docs/permissions/
    "bash": {
      "*": "ask",
      // Allow pre-specified read commands without prompting
      "git branch --show-current": "allow",
      "git diff": "allow",
      "git diff --cached": "allow",
      "git diff --check": "allow",
      "git diff --name-only": "allow",
      "git diff --stat": "allow",
      "git log": "allow",
      "git log --oneline": "allow",
      "git rev-parse --show-toplevel": "allow",
      "git show": "allow",
      "git show --stat": "allow",
      "git status": "allow",
      "git status --porcelain": "allow",
      "git status --short": "allow",
      "git status --short --branch": "allow",
      "ls": "allow",
      "ls -la": "allow",
      "pwd": "allow",
      "rg --files": "allow",
      // Ask before running certain write commands
      "gh * delete *": "ask",
      "gh pr close *": "ask",
      "gh pr create *": "ask",
      "gh pr create": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git tag *": "ask",
      "rm*": "ask",
      "vercel * delete *": "ask",
      "vercel remove *": "ask",
      "vercel rm *": "ask",
      // Do not let the agent expose OpenCode's optional HTTP servers
      "*opencode serve*": "deny",
      "*opencode web*": "deny",
      // Deny sudo
      "sudo *": "deny",
    },
    "context7_*": "allow",
    "doom_loop": "deny",
    "edit": "allow",
    "external_directory": {
      "*": "ask",
      "~/.bun/**": "allow",
      "~/.cache/**": "allow",
      "~/.cargo/**": "allow",
      "~/.claude/**": "allow",
      "~/.docker/**": "allow",
      "~/.local/**": "allow",
      "~/.npm/**": "allow",
      "~/.prefect/**": "allow",
      "~/.ruff_cache/**": "allow",
      "~/.rustup/**": "allow",
      "~/code/**": "allow",
      "~/Library/Caches/**": "allow",
      "~/Library/pnpm/**": "allow",
      "~/Library/Preferences/pnpm/**": "allow",
    },
    "github_*": "allow",
    "github_create_repository": "ask",
    "github_label_write": "ask",
    "github_mark_all_notifications_read": "ask",
    "github_merge_pull_request": "ask",
    "github_unstar_repository": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "openai_developer_docs_*": "allow",
    "opentofu_*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "example.env": "allow",
    },
    "skill": "allow",
    "spacelift_discover": "allow",
    "spacelift_intent": "ask",
    "spacelift_mutate": "ask",
    "spacelift_provider": "allow",
    "spacelift_query": "allow",
    "task": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "ask",
    "websearch": "ask",
  },
  // OpenCode has no server disable switch. Keep opt-in servers local-only.
  "server": {
    "hostname": "127.0.0.1",
    "mdns": false,
    "cors": [],
  },
  "share": "disabled",
}
