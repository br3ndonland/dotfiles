# shellcheck shell=sh

USAGE="
Cache Bitwarden secrets in the system keyring.

Requires Bitwarden CLI (bw) for reads and jq for named custom fields. On an
interactive cache miss, a locked vault prompts for the master password. Other
Bitwarden calls are non-interactive. Uses macOS Keychain or libsecret
(secret-tool) for caching. A registry of cached keys is stored in
\${XDG_CACHE_HOME:-\$HOME/.cache}/codex/bw_cache_keys.

Usage: bw_cache COMMAND [ARGS]

Commands:
  read CACHE_KEY BW_OBJECT BW_ITEM
                          Run 'bw get BW_OBJECT BW_ITEM', cache under CACHE_KEY,
                          and print the value. BW_OBJECT is case-insensitive.
                          BW_ITEM may be an item ID or a matching search string.
  read-field CACHE_KEY BW_ITEM FIELD_NAME
                          Read a named custom field from a Bitwarden item, cache
                          under CACHE_KEY, and print the value.
  clear [CACHE_KEY...]    Clear specific cache keys or clear all if no key given.
  list                    List tracked cache keys.
  help | -h | --help      Show this help text.

Examples:
  bw_cache read github_fgt password \"GitHub Fine-Grained Token\"
  bw_cache read-field github_fgt \"GitHub Fine-Grained Token\" token
  bw_cache list
  bw_cache clear github_fgt
  bw_cache clear
"

subcommand=$1
[ -z "$subcommand" ] && printf '%s' "$USAGE" && return 1
if { [ "$subcommand" = "read" ] || [ "$subcommand" = "read-field" ]; } &&
  ! command -v bw >/dev/null 2>&1; then
  printf '[ERROR] bw CLI not found\n' >&2
  return 1
fi
if [ "$subcommand" = "read-field" ] && ! command -v jq >/dev/null 2>&1; then
  printf '[ERROR] jq not found\n' >&2
  return 1
fi
shift 1 2>/dev/null || true
platform=$(uname 2>/dev/null)

_bw_cache_track_key() {
  _bw_cache_registry_dir=${XDG_CACHE_HOME:-$HOME/.cache}/codex
  _bw_cache_registry_file=$_bw_cache_registry_dir/bw_cache_keys
  _bw_cache_cache_key=$1

  if [ ! -d "$_bw_cache_registry_dir" ]; then
    mkdir -p "$_bw_cache_registry_dir" 2>/dev/null || return 0
  fi

  if [ -f "$_bw_cache_registry_file" ] &&
    grep -Fx "$_bw_cache_cache_key" "$_bw_cache_registry_file" >/dev/null 2>&1; then
    return 0
  fi

  printf '%s\n' "$_bw_cache_cache_key" >>"$_bw_cache_registry_file" 2>/dev/null
}

_bw_cache_delete_key() {
  _bw_cache_cache_key=$1

  if [ "$platform" = "Darwin" ]; then
    security find-generic-password \
      -a "$USER" \
      -s "codex/bitwarden/$_bw_cache_cache_key" \
      -w \
      >/dev/null 2>&1
    _bw_cache_status=$?
    if [ "$_bw_cache_status" -eq 44 ]; then
      return 0
    fi
    if [ "$_bw_cache_status" -ne 0 ]; then
      return "$_bw_cache_status"
    fi

    security delete-generic-password \
      -a "$USER" \
      -s "codex/bitwarden/$_bw_cache_cache_key" \
      >/dev/null 2>&1
    _bw_cache_status=$?
    if [ "$_bw_cache_status" -eq 44 ]; then
      return 0
    fi
    return "$_bw_cache_status"
  fi

  if command -v secret-tool >/dev/null 2>&1; then
    secret-tool lookup \
      app codex \
      provider bitwarden \
      key "$_bw_cache_cache_key" \
      >/dev/null 2>&1
    _bw_cache_status=$?
    if [ "$_bw_cache_status" -ne 0 ]; then
      return 0
    fi

    secret-tool clear \
      app codex \
      provider bitwarden \
      key "$_bw_cache_cache_key" \
      >/dev/null 2>&1
    return $?
  fi

  printf '[ERROR] no keyring tool available\n' >&2
  return 1
}

_bw_cache_prune_registry_keys() {
  _bw_cache_registry_file=$1
  _bw_cache_removed_keys_file=$2
  _bw_cache_registry_tmp=$_bw_cache_registry_file.$$

  if [ ! -f "$_bw_cache_registry_file" ] || [ ! -s "$_bw_cache_removed_keys_file" ]; then
    return 0
  fi

  if awk 'NR==FNR{a[$0]=1;next} !a[$0]' \
    "$_bw_cache_removed_keys_file" \
    "$_bw_cache_registry_file" \
    >"$_bw_cache_registry_tmp" 2>/dev/null; then
    if [ -s "$_bw_cache_registry_tmp" ]; then
      mv "$_bw_cache_registry_tmp" "$_bw_cache_registry_file"
    else
      rm -f "$_bw_cache_registry_file" "$_bw_cache_registry_tmp" >/dev/null 2>&1
    fi
  fi

  rm -f "$_bw_cache_registry_tmp" >/dev/null 2>&1
}

_bw_cache_fetch() {
  if [ "$subcommand" = "read" ]; then
    bw --nointeraction get "$bw_object" "$bw_item"
  else
    bw --nointeraction get item "$bw_item" |
      jq -er --arg field "$bw_field" \
        'first(.fields[]? | select(.name == $field) | .value) // empty'
  fi
}

_bw_cache_vault_status() {
  bw --nointeraction status 2>/dev/null |
    sed -n 's/.*"status":[[:space:]]*"\([^"]*\)".*/\1/p'
}

_bw_cache_unlock_and_fetch() {
  if [ ! -t 0 ]; then
    printf '%s\n' \
      '[ERROR] Bitwarden vault is locked; run:' \
      "  export BW_SESSION=\"\$(bw unlock --raw)\"" >&2
    return 1
  fi

  printf '[INFO] Bitwarden vault is locked; enter your master password to unlock it.\n' >&2
  BW_SESSION=$(bw unlock --raw) || return $?
  if [ -z "$BW_SESSION" ]; then
    printf '[ERROR] Bitwarden did not return an unlock session\n' >&2
    return 1
  fi
  export BW_SESSION

  if _bw_cache_fetch 2>/dev/null; then
    return 0
  fi

  bw --nointeraction sync >/dev/null 2>&1
  _bw_cache_fetch
}

case "$subcommand" in
read | read-field)
  if [ "$#" -ne 3 ]; then
    if [ "$subcommand" = "read" ]; then
      printf 'usage: bw_cache read CACHE_KEY BW_OBJECT BW_ITEM\n' >&2
    else
      printf 'usage: bw_cache read-field CACHE_KEY BW_ITEM FIELD_NAME\n' >&2
    fi
    return 1
  fi

  cache_key=$1
  if [ "$subcommand" = "read" ]; then
    bw_object=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
    bw_item=$3
  else
    bw_item=$2
    bw_field=$3
  fi

  cached=
  if [ "$platform" = "Darwin" ]; then
    cached=$(
      security find-generic-password \
        -a "$USER" \
        -s "codex/bitwarden/$cache_key" \
        -w \
        2>/dev/null
    )
  elif command -v secret-tool >/dev/null 2>&1; then
    cached=$(
      secret-tool lookup \
        app codex \
        provider bitwarden \
        key "$cache_key" \
        2>/dev/null
    )
  fi

  if [ -n "$cached" ]; then
    _bw_cache_track_key "$cache_key"
    printf '%s' "$cached"
    return 0
  fi

  fresh=$(_bw_cache_fetch 2>/dev/null)
  fetch_return_code=$?
  if [ "$fetch_return_code" -ne 0 ] &&
    [ "$(_bw_cache_vault_status)" = "locked" ]; then
    fresh=$(_bw_cache_unlock_and_fetch)
    fetch_return_code=$?
    if [ "$fetch_return_code" -ne 0 ]; then
      return "$fetch_return_code"
    fi
  elif [ -z "$fresh" ]; then
    # The local vault snapshot may predate the item. Refresh and retry once,
    # letting bw report on the second attempt so real errors still surface.
    if ! bw --nointeraction sync >/dev/null 2>&1; then
      _bw_cache_fetch >/dev/null
      return 1
    fi
    fresh=$(_bw_cache_fetch)
    fetch_return_code=$?
    if [ "$fetch_return_code" -ne 0 ]; then
      return "$fetch_return_code"
    fi
  fi
  if [ -n "$fresh" ]; then
    store_return_code=1
    if [ "$platform" = "Darwin" ]; then
      security add-generic-password \
        -a "$USER" \
        -s "codex/bitwarden/$cache_key" \
        -w "$fresh" \
        -U \
        >/dev/null 2>&1
      store_return_code=$?
    elif command -v secret-tool >/dev/null 2>&1; then
      printf '%s' "$fresh" | secret-tool store \
        --label="codex/bitwarden/$cache_key" \
        app codex \
        provider bitwarden \
        key "$cache_key" \
        >/dev/null 2>&1
      store_return_code=$?
    fi

    if [ "$store_return_code" -eq 0 ]; then
      _bw_cache_track_key "$cache_key"
    fi
    printf '%s' "$fresh"
    return 0
  fi

  printf '[ERROR] %s not found in Bitwarden (after sync)\n' "$bw_item" >&2
  return 1
  ;;
clear)
  registry_dir=${XDG_CACHE_HOME:-$HOME/.cache}/codex
  registry_file=$registry_dir/bw_cache_keys
  return_code=0

  if [ "$#" -eq 0 ]; then
    if [ ! -f "$registry_file" ]; then
      return 0
    fi

    cleared_keys_file=$registry_dir/bw_cache_keys.cleared.$$
    : >"$cleared_keys_file" 2>/dev/null

    while IFS= read -r cache_key; do
      if [ -z "$cache_key" ]; then
        continue
      fi
      if _bw_cache_delete_key "$cache_key"; then
        printf '%s\n' "$cache_key" >>"$cleared_keys_file" 2>/dev/null
      else
        printf '[ERROR] failed to delete cache key %s\n' "$cache_key" >&2
        return_code=1
      fi
    done <"$registry_file"

    _bw_cache_prune_registry_keys "$registry_file" "$cleared_keys_file"
    rm -f "$cleared_keys_file" >/dev/null 2>&1
    return "$return_code"
  fi

  cleared_keys_file=
  if [ -f "$registry_file" ]; then
    cleared_keys_file=$registry_dir/bw_cache_keys.cleared.$$
    : >"$cleared_keys_file" 2>/dev/null
  fi

  for cache_key in "$@"; do
    if ! _bw_cache_delete_key "$cache_key"; then
      printf '[ERROR] failed to delete cache key %s\n' "$cache_key" >&2
      return_code=1
    elif [ -n "$cleared_keys_file" ]; then
      printf '%s\n' "$cache_key" >>"$cleared_keys_file" 2>/dev/null
    fi
  done

  if [ -n "$cleared_keys_file" ] && [ -s "$cleared_keys_file" ]; then
    _bw_cache_prune_registry_keys "$registry_file" "$cleared_keys_file"
  fi
  if [ -n "$cleared_keys_file" ]; then
    rm -f "$cleared_keys_file" >/dev/null 2>&1
  fi

  return "$return_code"
  ;;
list)
  if [ "$#" -ne 0 ]; then
    printf 'usage: bw_cache list\n' >&2
    return 1
  fi

  registry_file=${XDG_CACHE_HOME:-$HOME/.cache}/codex/bw_cache_keys
  if [ -f "$registry_file" ]; then
    cat "$registry_file"
  fi
  return 0
  ;;
help | -h | --help)
  printf '%s' "$USAGE"
  return 0
  ;;
*)
  printf '[ERROR] unknown subcommand: %s\n' "$subcommand" >&2
  printf '%s' "$USAGE"
  return 1
  ;;
esac
