  "lsp": {
    "cspell": {
      "settings": {
        "cSpell": {
          "import": ["~/.dotfiles/vscode/User/cspell.json"],
          "diagnosticLevel": "Information",
          "spellCheckDelayMs": 5000,
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lint": {
            "extendSelect": ["I", "UP"],
          },
        },
      },
    },
    "tofu-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true,
          "validateOnSave": true,
        },
      },
    },
    "vtsls": {
      "settings": {
        "javascript": {
          "implementationsCodeLens": {
            "enabled": true,
            "showOnInterfaceMethods": true,
          },
          "referencesCodeLens": {
            "enabled": true,
          },
          "inlayHints": {
            "functionLikeReturnTypes": {
              "enabled": true,
            },
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false,
            },
          },
        },
        "typescript": {
          "implementationsCodeLens": {
            "enabled": true,
            "showOnInterfaceMethods": true,
          },
          "referencesCodeLens": {
            "enabled": true,
          },
          "inlayHints": {
            "functionLikeReturnTypes": {
              "enabled": true,
            },
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false,
            },
          },
        },
      },
    },
  },
