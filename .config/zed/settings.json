{
  // save behavior
  "autosave": "on_window_change",
  "ensure_final_newline_on_save": true,
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "restore_on_startup": "last_session",
  // general settings
  "auto_update": false,
  "base_keymap": "VSCode",
  "buffer_font_family": "Rec Mono Duotone",
  "buffer_font_fallbacks": [".ZedMono"],
  "buffer_font_features": { "calt": true },
  "buffer_font_size": 14,
  "code_lens": "on",
  "colorize_brackets": false,
  "cursor_blink": false,
  "hard_tabs": false,
  "inlay_hints": { "enabled": true },
  "minimap": { "show": "never" },
  "show_completions_on_input": true,
  "show_edit_predictions": true,
  "show_whitespaces": "none",
  "soft_wrap": "none",
  "tab_size": 2,
  "telemetry": { "metrics": false, "diagnostics": false },
  "toolbar": { "breadcrumbs": true },
  // panels
  "project_panel": {
    "dock": "left",
    "git_status": true,
    "git_status_indicator": false,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "git_panel": {
    "dock": "left",
  },
  "terminal": {
    "dock": "right",
    "font_size": 12,
    "cursor_shape": "bar",
    "cursor_blink": "off",
    "max_scroll_history_lines": 10000,
    "minimum_contrast": 1,
  },
  // ai agents
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },
  // extensions
  "auto_install_extensions": {
    "astro": true,
    "catppuccin-icons": true,
    "cspell": true,
    "docker-compose": true,
    "dockerfile": true,
    "dracula": true,
    "emmet": true,
    "env": true,
    "github-actions": true,
    "html": true,
    "mdx": true,
    "opentofu": true,
    "rego": true,
    "svelte": true,
    "tombi": true,
    "vue": true,
  },
  "auto_update_extensions": {
    "astro": false,
    "catppuccin-icons": false,
    "cspell": false,
    "docker-compose": false,
    "dockerfile": false,
    "dracula": false,
    "emmet": false,
    "env": false,
    "github-actions": false,
    "html": false,
    "mdx": false,
    "opentofu": false,
    "rego": false,
    "svelte": false,
    "tombi": false,
    "vue": false,
  },
  // files
  "file_types": {
    "Env": ["env", ".env.*"],
    "Shell Script": ["**/.config/shell/functions/*"],
    "JSONC": [
      "**/.vscode/**/*.json",
      "**/zed/*.json",
      "**/zed/themes/*.json",
      "*.code-snippets",
    ],
    "Rego": ["rego", "*.rego*"],
  },
  "file_scan_exclusions": [
    // default
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // custom
    "**/._*",
    "**/*cache*",
    "**/.astro",
    "**/.coverage*",
    "**/.venv",
    "**/dist",
    "**/node_modules",
  ],
  // languages
  "languages": {
    "Astro": {
      "colorize_brackets": false,
      "show_whitespaces": "none",
      "show_edit_predictions": true,
      "ensure_final_newline_on_save": true,
      "format_on_save": "on",
      "soft_wrap": "none",
      "hard_tabs": false,
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "CSS": {
      "colorize_brackets": false,
      "show_whitespaces": "none",
