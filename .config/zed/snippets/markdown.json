{
  "GitHub Issue": {
    "prefix": "ghi",
    "body": [
      "# $1\n",
      "\n---\n",
      "## Description\n\n$2\n",
      "## Suggestions\n\n$3\n",
      "## Related\n\n$4\n",
      "\n---\n",
      "## Comments\n",
      "\n---\n",
      "## Notes\n"
    ],
    "description": "GitHub Issue template"
  },
  "GitHub Pull Request": {
    "prefix": "ghp",
    "body": [
      "# $1\n",
      "\n---\n",
      "## Description\n\n$2\n",
      "## Changes\n\n$3\n",
      "## Related\n\n$4\n",
      "\n---\n",
      "## Squash message\n",
      "\n---\n",
      "## Comments\n",
      "\n---\n",
      "## Notes\n"
    ],
    "description": "GitHub Pull Request template"
  },
  "Markdown HTML anchor link": {
    "prefix": "malink",
    "body": "<a href=\"${1:https://example.com}\" rel=\"external\" target=\"_blank\">${2:text}</a>$0",
    "description": "HTML anchor element for Markdown files"
  },
  "Markdown HTML img": {
    "prefix": "mimg",
    "body": "<img src=\"$1\" alt=\"$2\" width=\"${3:75%}\" />$0",
    "description": "HTML image tag for Markdown files"
  },
  "Markdown HTML details": {
    "prefix": "md",
    "body": "<details><summary>${1:Summary}</summary>\n\n${2:Details}\n</details>\n$0",
    "description": "HTML details element for Markdown files"
  },
  "Prettier ignore": {
    "prefix": "pi",
    "body": "<!-- prettier-ignore -->\n$0",
    "description": "Ignore the next node when formatting with Prettier"
  }
}
